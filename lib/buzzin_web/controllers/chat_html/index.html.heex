<div class="container mx-auto px-4">
    <div class="flex h-screen">
      <!-- Sidebar with chat list -->
      <div class="w-1/3 border-r p-4">
        <div class="mb-4">
          <h2 class="text-xl font-bold">Chats</h2>
        </div>
        
        <!-- New Chat Button -->
        <div class="mb-4">
          <button
            id="new-chat-btn"
            class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"
            onclick="toggleNewChatForm()"
          >
            New Chat
          </button>
        </div>
  
        <!-- New Chat Form (hidden by default) -->
        <div id="new-chat-form" class="hidden mb-4">
          <form id="start-chat-form">
            <.input
              label="Enter Phone Number"
              id="recipient_phone"
              name="recipient_phone"
              type="text"
              required
            />
            <.button type="submit" class="mt-2">
              Start Chat
            </.button>
          </form>
        </div>
  
        <!-- Chat List -->
        <div id="chat-list" class="space-y-2">
          <!-- Chat items will be populated here -->
        </div>
      </div>
  
      <!-- Chat Area -->
      <div class="w-2/3 p-4">
        <div id="current-chat" class="h-full flex flex-col">
          <!-- Default message when no chat is selected -->
          <div class="flex-grow flex items-center justify-center text-gray-500">
            Select a chat or start a new conversation
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <script>
    // Check if user is logged in
    const user = JSON.parse(localStorage.getItem('user'));
    if (!user) {
      window.location.href = '/login';
    }
  
    function toggleNewChatForm() {
      const form = document.getElementById('new-chat-form');
      form.classList.toggle('hidden');
    }
  
    // Handle new chat form submission
    document.getElementById('start-chat-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const recipientPhone = document.getElementById('recipient_phone').value;
      
      try {
        // Here you would typically:
        // 1. Verify the recipient exists
        // 2. Create or fetch an existing chat
        // 3. Update the UI
        
        // For now, just hide the form
        toggleNewChatForm();
        
        // TODO: Implement actual chat creation logic
        console.log('Starting chat with:', recipientPhone);
      } catch (error) {
        console.error('Error:', error);
        alert('Failed to start chat');
      }
    });
  
    // Function to load chats (to be implemented)
    async function loadChats() {
      // TODO: Fetch chats from backend
      // For now, this is just a placeholder
      const chatList = document.getElementById('chat-list');
      chatList.innerHTML = '<div class="text-gray-500">No chats yet</div>';
    }
  
    // Load chats when page loads
    loadChats();
  </script>