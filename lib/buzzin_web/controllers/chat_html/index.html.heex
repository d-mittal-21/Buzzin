<div class="container mx-auto px-4">
    <div class="flex h-screen">
      <!-- Sidebar with chat list -->
      <div class="w-1/3 border-r p-4">
        <div class="mb-4">
          <h2 class="text-xl font-bold">Chats</h2>
        </div>
        
        <!-- New Chat Button -->
        <div class="mb-4">
          <button
            id="new-chat-btn"
            class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"
            onclick="toggleNewChatForm()"
          >
            New Chat
          </button>
        </div>
  
        <!-- New Chat Form (hidden by default) -->
        <div id="new-chat-form" class="hidden mb-4">
          <form id="start-chat-form">
            <.input
              label="Enter Phone Number"
              id="recipient_phone"
              name="recipient_phone"
              type="text"
              required
              value=""
            />
            <.input
              label="Message"
              id="message_body"
              name="message_body"
              type="text"
              required
              value=""
            />
            <.button type="submit" class="mt-2">
              Start Chat
            </.button>
          </form>
        </div>
  
        <!-- Chat List -->
        <div id="chat-list" class="space-y-2">
          <!-- Chat items will be populated here -->
        </div>
      </div>
  
      <!-- Chat Area -->
      <div class="w-2/3 p-4">
        <!-- AI Assistant Button -->
        <div class="mb-4 flex justify-end">
          <button
            id="ai-assistant-btn"
            class="bg-purple-500 text-white px-4 py-2 rounded hover:bg-purple-600 flex items-center gap-2"
            onclick="toggleAIChat()"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            AI Assistant
          </button>
        </div>
        <div id="current-chat" class="h-full flex flex-col">
          <!-- Messages will be displayed here -->
          <div id="messages-container" class="flex-grow overflow-y-auto mb-4">
            <div class="flex items-center justify-center h-full text-gray-500" id="no-chat-selected">
              Select a chat or start a new conversation
            </div>
          </div>

          <!-- AI Chat Interface (hidden by default) -->
          <div id="ai-chat-container" class="h-full flex-grow overflow-y-auto mb-4 hidden">
            <div class="space-y-4" id="ai-messages">
              <div class="bg-purple-100 p-3 rounded-lg">
                Hi! I'm your AI assistant. I can help you analyze your chat history and answer questions about your conversations.
              </div>
            </div>
          </div>
  
          <!-- Message Input Form (hidden by default) -->
          <div id="message-input-form" class="hidden">
            <form id="send-message-form" class="flex gap-2">
              <input type="hidden" id="current-recipient-id" />
              <.input
                type="text"
                name="message"
                id="message-input"
                placeholder="Type a message..."
                class="flex-grow"
                required
                value=""
              />
              <.button type="submit">Send</.button>
            </form>
          </div>

           <!-- AI Chat Input Form (hidden by default) -->
          <div id="ai-input-form" class="hidden">
            <form id="ai-message-form" class="flex gap-2">
              <.input
                type="text"
                name="ai-message"
                id="ai-message-input"
                placeholder="Ask me anything about your chats..."
                class="flex-grow"
                required
                value=""
              />
              <.button type="submit">Ask</.button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <script>
    // Check if user is logged in
    const user = JSON.parse(localStorage.getItem('user'));
    if (!user) {
      window.location.href = '/login';
    }
  
    let currentRecipientId = null;
  
    function toggleNewChatForm() {
      const form = document.getElementById('new-chat-form');
      form.classList.toggle('hidden');
    }
  
    // Load and display conversations
    async function loadConversations() {
      try {
        const response = await fetch('/api/conversations', {
          credentials: 'include'
        });
        const data = await response.json();
        
        const chatList = document.getElementById('chat-list');
        if (data.data.length === 0) {
          chatList.innerHTML = '<div class="text-gray-500">No conversations yet</div>';
          return;
        }
  
        chatList.innerHTML = data.data.map(conv => `
          <div 
            class="p-3 hover:bg-gray-100 cursor-pointer rounded"
            onclick="loadMessages('${conv.other_user.id}', '${conv.other_user.phone_number}')"
          >
            <div class="font-medium">${conv.other_user.phone_number}</div>
            <div class="text-sm text-gray-500 truncate">${conv.last_message.body}</div>
          </div>
        `).join('');
      } catch (error) {
        console.error('Error loading conversations:', error);
      }
    }
  
    // Load messages for a specific conversation
    async function loadMessages(recipientId, recipientPhone) {
      // If AI chat is active, disable it first
      if (isAIChatActive) {
        isAIChatActive = false;
        const aiContainer = document.getElementById('ai-chat-container');
        const aiInput = document.getElementById('ai-input-form');
        aiContainer.classList.add('hidden');
        aiInput.classList.add('hidden');
      }
  
      currentRecipientId = recipientId;
      document.getElementById('current-recipient-id').value = recipientId;
      
      try {
        const response = await fetch(`/api/messages/${recipientId}`, {
          credentials: 'include'
        });
        const data = await response.json();
  
        const messagesContainer = document.getElementById('messages-container');
        const noChat = document.getElementById('no-chat-selected');
        const inputForm = document.getElementById('message-input-form');
        
        // Show messages container and input form
        messagesContainer.classList.remove('hidden');
        if (noChat) noChat.style.display = 'none';
        if (inputForm) inputForm.classList.remove('hidden');
  
        messagesContainer.innerHTML = data.data.map(msg => `
          <div class="mb-2 ${msg.sender_id === user.id ? 'text-right' : 'text-left'}">
            <div class="inline-block p-2 rounded-lg ${
              msg.sender_id === user.id 
                ? 'bg-blue-500 text-white' 
                : 'bg-gray-200 text-gray-800'
            }">
              ${msg.body}
            </div>
          </div>
        `).join('');
  
        // Scroll to bottom
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      } catch (error) {
        console.error('Error loading messages:', error);
      }
    }
  
    // Handle new chat form submission
    document.getElementById('start-chat-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const recipientPhone = document.getElementById('recipient_phone').value;
      const messageBody = document.getElementById('message_body').value;
      
      try {
        const response = await fetch('/api/messages', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify({
            recipient_phone: recipientPhone,
            body: messageBody
          })
        });
  
        if (response.ok) {
          toggleNewChatForm();
          document.getElementById('start-chat-form').reset();
          await loadConversations();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to start conversation');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Failed to start conversation');
      }
    });
  
    // Handle send message form submission
    document.getElementById('send-message-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const messageInput = document.getElementById('message-input');
      const recipientId = document.getElementById('current-recipient-id').value;
      
      if (!recipientId || !messageInput.value.trim()) {
        return;
      }
  
      try {
        const response = await fetch('/api/messages', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify({
            recipient_id: recipientId,  // Changed from recipient_phone to recipient_id
            body: messageInput.value
          })
        });
  
        if (response.ok) {
          messageInput.value = '';
          await loadMessages(recipientId);
          await loadConversations();
        } else {
          const data = await response.json();
          alert(data.error || 'Failed to send message');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Failed to send message');
      }
    });

    let isAIChatActive = false;

    function toggleAIChat() {
      isAIChatActive = !isAIChatActive;
      const messagesContainer = document.getElementById('messages-container');
      const aiContainer = document.getElementById('ai-chat-container');
      const messageInput = document.getElementById('message-input-form');
      const aiInput = document.getElementById('ai-input-form');
      const noChat = document.getElementById('no-chat-selected');
  
      if (isAIChatActive) {
        messagesContainer.classList.add('hidden');
        aiContainer.classList.remove('hidden');
        messageInput.classList.add('hidden');
        aiInput.classList.remove('hidden');
        if (noChat) noChat.style.display = 'none';
      } else {
        aiContainer.classList.add('hidden');
        aiInput.classList.add('hidden');
        
        // If there's a selected chat, show its messages
        if (currentRecipientId) {
          messagesContainer.classList.remove('hidden');
          messageInput.classList.remove('hidden');
          if (noChat) noChat.style.display = 'none';
        } else {
          messagesContainer.classList.remove('hidden');
          if (noChat) noChat.style.display = 'flex';
        }
      }
    }

    // Handle AI message form submission
    document.getElementById('ai-message-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const messageInput = document.getElementById('ai-message-input');
      const message = messageInput.value;
      const aiMessages = document.getElementById('ai-messages');
      
      // Add user message to chat
      aiMessages.innerHTML += `
        <div class="text-right">
          <div class="inline-block bg-blue-500 text-white p-3 rounded-lg">
            ${message}
          </div>
        </div>
      `;

      messageInput.value = '';
      
      try {
        const response = await fetch('/api/ai/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify({ message })
        });

        const data = await response.json();
        
        // Add AI response to chat
        aiMessages.innerHTML += `
          <div class="text-left">
            <div class="inline-block bg-purple-100 p-3 rounded-lg">
              ${data.response}
            </div>
          </div>
        `;

        // Scroll to bottom
        aiMessages.scrollTop = aiMessages.scrollHeight;
      } catch (error) {
        console.error('Error:', error);
        alert('Failed to get AI response');
      }
    });
  
    // Load conversations when page loads
    loadConversations();
  </script>